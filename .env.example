# Copy to .env and fill locally. Never commit .env.

# Network
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
# Placeholder: not deployed yet. See docs/testnet_accounts.md
TRUSTLOCK_CONTRACT_ID=trustlock.testnet
TRUSTLOCK_USDC_ACCOUNT=usdc.fakes.testnet

# Accounts (public IDs only in git history — keys stay here)
TRUSTLOCK_OWNER_ACCOUNT=
TRUSTLOCK_SELLER_ACCOUNT=
TRUSTLOCK_BUYER_ACCOUNT=
TRUSTLOCK_RIDER_ACCOUNT=

# Paths to key files on THIS machine, not the key material
TRUSTLOCK_OWNER_KEYFILE=
TRUSTLOCK_RIDER_KEYFILE=

# Deal agent
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
# Optional: Meta Muse / OpenRouter / Intron. Leave blank to use the stub NLU.
MUSE_API_KEY=
OPENROUTER_API_KEY=
INTRON_API_KEY=

# NEAR Intents / 1Click
# No public Intents testnet (HACKATHON.md Q-007). dry = quotes only.
TRUSTLOCK_INTENTS_MODE=dry
# demo | dry | live  (label the UI the same way)
TRUSTLOCK_APP_MODE=demo
ONECLICK_API_URL=https://1click.chaindefuser.com
# Optional partner JWT from https://partners.near-intents.org (auth wall; 0.2% fee without it)
ONECLICK_JWT=

# Frontend (all NEXT_PUBLIC_* values are visible to browsers)
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
NEXT_PUBLIC_CONTRACT_ID=trustlock.testnet
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_APP_MODE=demo
